{
  "version": 2,
  "buildCommand": "cd BankEase-Frontend && npm ci && npm run build",
  "outputDirectory": "BankEase-Frontend/dist/BankEase-Frontend/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://bankease-backend.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
