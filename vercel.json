{
  "version": 2,
  "buildCommand": "cd BankEase-Frontend && npm ci && npm run build",
  "outputDirectory": "BankEase-Frontend/dist/BankEase-Frontend/browser",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
